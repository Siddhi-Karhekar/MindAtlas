# Copy this file to .env and fill in real values when you're ready to go live.
# Until then, leaving MONGODB_URI unset makes the server spin up an
# in-memory MongoDB automatically (mongodb-memory-server) - perfect for
# local development, but data does not persist across restarts.

PORT=4000

# Real MongoDB Atlas connection string. Leave blank to use the in-memory
# dev database instead.
MONGODB_URI=

# Any long random string. Required in production; a dev default is used
# automatically if this is left blank.
JWT_SECRET=

# Groq API key for the LLM-drafted test questions / feedback phrasing
# feature (not required for the notes -> knowledge graph vertical slice).
GROQ_API_KEY=
