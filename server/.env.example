# Copy this file to .env and fill in real values when you're ready to go live.
# Until then, leaving MONGODB_URI unset makes the server use a small built-in
# database (see server/src/db/memoryStore.js) saved to
# server/data/mindatlas-db.json - perfect for local development, and data
# persists across restarts.

PORT=4000

# Set to "production" when deployed. In production the server refuses to
# start without a strong JWT_SECRET, and allows no cross-origin browser
# access unless CORS_ORIGIN is set.
NODE_ENV=development

# Real MongoDB Atlas connection string. Leave blank to use the built-in
# local database, which is saved to server/data/mindatlas-db.json so your
# accounts and notes survive restarts.
MONGODB_URI=

# Optional: where that local database file lives. Set DB_FILE=memory for a
# throwaway in-memory database that is wiped every restart.
# DB_FILE=

# Any long random string (32+ characters, required in production). Generate
# one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a built-in insecure default is used (with a warning) if
# this is left blank.
JWT_SECRET=

# Groq API key for LLM-drafted test questions, theory-answer grading and
# feedback phrasing. Optional: without it every one of those features falls
# back to a rule-based / template path.
GROQ_API_KEY=

# Comma-separated list of browser origins allowed to call this API, e.g.
#   CORS_ORIGIN=https://mindatlas.vercel.app
# Leave blank in development (http://localhost:5173 is allowed
# automatically). Leaving it blank in production blocks all cross-origin
# browser access.
CORS_ORIGIN=

# Number of reverse-proxy hops in front of the API (1 on Render / Railway /
# Fly / behind nginx). Needed so rate limiting sees each user's real IP.
# Leave blank when running locally with no proxy.
TRUST_PROXY=

# Meaning-based question ranking (optional add-on, free, runs on this machine).
# With it installed - `npm run semantic:install` in server/ - a small local
# embedding model (all-MiniLM-L6-v2) judges which sentences are on topic and
# which phrases are key terms. Not installed, or set to off, the server uses
# rule-based ranking instead; nothing else changes. It holds about 125 MB of
# memory once loaded: `npm run semantic:check` measures it on your machine.
# SEMANTIC_MODEL=off
# A folder that already contains the model, to avoid the one-time download
# from huggingface.co (the folder holds Xenova/all-MiniLM-L6-v2/...):
# SEMANTIC_MODEL_PATH=

# ---------------------------------------------------------------------------
# Email (optional). With it set up, a new account has to confirm its address
# before it can be used, and "Forgot password?" appears on the sign-in page.
# Without it, accounts work unconfirmed and passwords cannot be reset by email.
# Any provider's SMTP details work; free ones include a Gmail account with an
# "app password" (smtp.gmail.com, port 465) and Brevo (smtp-relay.brevo.com, 587).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Mind Atlas <you@example.com>
# The web app's public address, for the links in those emails. Defaults to the
# first CORS_ORIGIN, then to the address Render gives the service.
# APP_URL=https://mindatlas.onrender.com
# Development only: "send" email by printing it to this server's console, to
# try the confirmation and reset pages without a mail account.
# EMAIL_MODE=log

# ---------------------------------------------------------------------------
# Security settings. The defaults are the safe ones; see docs/SECURITY.md.
# Work per password guess, 10 to 14. 10 suits the free hosting tier's CPU.
# BCRYPT_ROUNDS=10
# Sign-up bot checks (hidden field + timed challenge): on in production, off
# elsewhere so tests and scripts can create accounts. "on" / "off" overrides.
# SIGNUP_CHALLENGE=
# Production refuses plain HTTP when the host's proxy reports it. "off" disables.
# FORCE_HTTPS=
# Wrong passwords for one account before it is locked for 15 minutes: from
# one address, and from anywhere.
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_ACCOUNT=100
# Reading an uploaded document: stopped after this many seconds, and allowed
# this much memory. Two files are read at a time.
# EXTRACT_TIMEOUT_SECONDS=25
# EXTRACT_MAX_HEAP_MB=256
# Development only (ignored in production): let GET /api/tests/:id?keys=1
# include answer keys, for verify/e2e_cross_attempt.py.
# TEST_REVEAL_KEYS=1

# Optional rate-limit overrides, per 15 minutes unless said otherwise.
# The whole API, per signed-in student (per address for anyone not signed in):
# RATE_LIMIT_API_MAX=600
# Sign-in, sign-up, password change/reset and email links, per address:
# RATE_LIMIT_AUTH_MAX=60
# New accounts per address per HOUR (a classroom shares one address):
# RATE_LIMIT_REGISTER_MAX=40
# Password-reset emails per address per HOUR:
# RATE_LIMIT_FORGOT_MAX=10
# Per student:
# RATE_LIMIT_TEST_BUILD_MAX=20
# RATE_LIMIT_EXPORT_MAX=60
# RATE_LIMIT_UPLOAD_MAX=60
